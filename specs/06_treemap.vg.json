{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Chart 6. Two-level treemap (built in Vega): maker regions, then maker countries inside them. Box size = number of bars reviewed. Shade = average rating.",
  "width": 480,
  "height": 380,
  "padding": {"left": 0, "right": 0, "top": 0, "bottom": 66},
  "autosize": "none",
  "signals": [
    {
      "name": "hoverCountry",
      "value": null,
      "on": [
        {"events": "@leaf:pointerover", "update": "datum.maker_country"},
        {"events": "@leaf:pointerout", "update": "null"}
      ]
    }
  ],
  "data": [
    {
      "name": "bars",
      "url": "data/processed/chocolate.csv",
      "format": {"type": "csv", "parse": "auto"},
      "transform": [
        {"type": "filter", "expr": "isValid(datum.maker_region) && datum.maker_region != ''"},
        {
          "type": "aggregate",
          "groupby": ["maker_region", "maker_country"],
          "fields": ["rating", "rating"],
          "ops": ["count", "mean"],
          "as": ["n_bars", "avg_rating"]
        }
      ]
    },
    {
      "name": "tree",
      "source": "bars",
      "transform": [
        {"type": "nest", "keys": ["maker_region"], "generate": true},
        {
          "type": "treemap",
          "field": "n_bars",
          "sort": {"field": "value", "order": "descending"},
          "round": true,
          "method": "squarify",
          "ratio": 1.4,
          "paddingInner": 3,
          "paddingTop": 20,
          "size": [{"signal": "width"}, {"signal": "height"}]
        }
      ]
    },
    {
      "name": "regions",
      "source": "tree",
      "transform": [{"type": "filter", "expr": "datum.depth == 1"}]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [{"type": "filter", "expr": "datum.depth == 2"}]
    }
  ],
  "scales": [
    {
      "name": "colour",
      "type": "linear",
      "domain": [2.8, 3.5],
      "range": ["#EFD5B2", "#C48A57", "#4E2A16"],
      "clamp": true,
      "zero": false
    }
  ],
  "legends": [
    {
      "fill": "colour",
      "title": "Average rating (out of 5)",
      "orient": "none",
      "legendX": 0,
      "legendY": 392,
      "direction": "horizontal",
      "gradientLength": 180,
      "format": ".1f",
      "values": [2.8, 3, 3.2, 3.4]
    }
  ],
  "marks": [
    {
      "description": "Region blocks with a thick outline and a label strip at the top",
      "type": "rect",
      "from": {"data": "regions"},
      "encode": {
        "enter": {
          "x": {"field": "x0"},
          "y": {"field": "y0"},
          "x2": {"field": "x1"},
          "y2": {"field": "y1"},
          "fill": {"value": "#F6EFE6"},
          "stroke": {"value": "#2B1D14"},
          "strokeWidth": {"value": 1.5}
        }
      }
    },
    {
      "type": "text",
      "from": {"data": "regions"},
      "encode": {
        "enter": {
          "x": {"signal": "datum.x0 + 5"},
          "y": {"signal": "datum.y0 + 14"},
          "text": {
            "signal": "datum.x1 - datum.x0 > 70 ? datum.key : (datum.x1 - datum.x0 > 34 ? slice(datum.key, 0, 4) + '…' : '')"
          },
          "fontSize": {"value": 12},
          "fontWeight": {"value": 700},
          "fill": {"value": "#2B1D14"}
        }
      }
    },
    {
      "name": "leaf",
      "description": "Country boxes",
      "type": "rect",
      "from": {"data": "leaves"},
      "encode": {
        "enter": {
          "x": {"field": "x0"},
          "y": {"field": "y0"},
          "x2": {"field": "x1"},
          "y2": {"field": "y1"},
          "fill": {"scale": "colour", "field": "avg_rating"},
          "cursor": {"value": "pointer"},
          "tooltip": {
            "signal": "{'Maker country': datum.maker_country, 'Region': datum.maker_region, 'Bars reviewed': datum.n_bars, 'Average rating': format(datum.avg_rating, '.2f')}"
          }
        },
        "update": {
          "stroke": {"signal": "hoverCountry == datum.maker_country ? '#B5652B' : '#FFFDF9'"},
          "strokeWidth": {"signal": "hoverCountry == datum.maker_country ? 3 : 1"}
        }
      }
    },
    {
      "description": "Country names, only where the box is big enough to read them",
      "type": "text",
      "from": {"data": "leaves"},
      "interactive": false,
      "encode": {
        "enter": {
          "x": {"signal": "datum.x0 + 5"},
          "y": {"signal": "datum.y0 + 15"},
          "text": {
            "signal": "(datum.x1 - datum.x0 > 62 && datum.y1 - datum.y0 > 22) ? datum.maker_country : ''"
          },
          "fontSize": {"value": 12},
          "limit": {"signal": "datum.x1 - datum.x0 - 8"},
          "fill": {"signal": "datum.avg_rating > 3.15 ? '#FFFDF9' : '#2B1D14'"}
        }
      }
    },
    {
      "description": "Number of bars under the country name, for the biggest boxes",
      "type": "text",
      "from": {"data": "leaves"},
      "interactive": false,
      "encode": {
        "enter": {
          "x": {"signal": "datum.x0 + 5"},
          "y": {"signal": "datum.y0 + 29"},
          "text": {
            "signal": "(datum.x1 - datum.x0 > 62 && datum.y1 - datum.y0 > 40) ? format(datum.n_bars, ',') + ' bars' : ''"
          },
          "fontSize": {"value": 11},
          "fill": {"signal": "datum.avg_rating > 3.15 ? '#FFFDF9' : '#6E5A4B'"}
        }
      }
    }
  ]
}
