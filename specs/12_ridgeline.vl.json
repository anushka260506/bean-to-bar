{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 12. Ridgeline plot: one smoothed 'hill' per group of review years, showing where ratings bunch up. A taller hump means more bars got that score. A thin baseline joins each hill to its year label, and a white line with a number marks that period's average rating, so you can see the hills move right over time.",
  "data": {"url": "data/processed/chocolate.csv"},
  "transform": [
    {"joinaggregate": [{"op": "max", "field": "review_year", "as": "last_year"}]},
    {"calculate": "2006 + floor((datum.review_year - 2006) / 3) * 3", "as": "period_start"},
    {
      "calculate": "min(datum.period_start + 2, datum.last_year) == datum.period_start ? '' + datum.period_start : datum.period_start + '–' + min(datum.period_start + 2, datum.last_year)",
      "as": "period"
    },
    {
      "joinaggregate": [
        {"op": "mean", "field": "rating", "as": "period_avg"},
        {"op": "count", "as": "period_n"}
      ],
      "groupby": ["period"]
    },
    {
      "density": "rating",
      "groupby": ["period", "period_start", "period_avg", "period_n"],
      "bandwidth": 0.18,
      "extent": [1.5, 4.5],
      "steps": 160,
      "as": ["value", "density"]
    }
  ],
  "facet": {
    "row": {
      "field": "period",
      "type": "nominal",
      "title": null,
      "sort": {"field": "period_start"},
      "header": {
        "labelAngle": 0,
        "labelAlign": "left",
        "labelAnchor": "start",
        "labelOrient": "left",
        "labelPadding": 12,
        "labelFontSize": 12,
        "labelColor": "#2B1D14"
      }
    }
  },
  "spacing": 0,
  "spec": {
    "width": 930,
    "height": 38,
    "layer": [
      {
        "description": "Baseline that joins the year label to its hill",
        "mark": {"type": "rule", "color": "#C9B8A6", "strokeWidth": 1},
        "encoding": {"y": {"datum": 0, "type": "quantitative", "axis": null}}
      },
      {
        "mark": {
          "type": "area",
          "interpolate": "monotone",
          "fillOpacity": 0.92,
          "stroke": "#FFFDF9",
          "strokeWidth": 1.2,
          "cursor": "pointer"
        },
        "encoding": {
          "x": {
            "field": "value",
            "type": "quantitative",
            "title": "Rating (out of 5)",
            "scale": {"domain": [1.5, 4.5]},
            "axis": {"values": [1.5, 2, 2.5, 3, 3.5, 4, 4.5], "grid": false}
          },
          "y": {
            "field": "density",
            "type": "quantitative",
            "axis": null,
            "scale": {"range": [38, -34]}
          },
          "fill": {
            "field": "period_avg",
            "type": "quantitative",
            "title": "Average rating",
            "scale": {
              "domain": [2.9, 3.35],
              "range": ["#E0B98A", "#C48A57", "#4E2A16"],
              "clamp": true
            },
            "legend": {
              "orient": "bottom",
              "direction": "horizontal",
              "gradientLength": 160,
              "format": ".2f",
              "values": [2.9, 3.1, 3.3]
            }
          },
          "tooltip": [
            {"field": "period", "title": "Review years"},
            {"field": "period_avg", "title": "Average rating", "format": ".2f"},
            {"field": "period_n", "title": "Bars reviewed", "format": ","}
          ]
        }
      },
      {
        "description": "Average rating for the period: a white line through the hill",
        "transform": [
          {
            "aggregate": [
              {"op": "max", "field": "period_avg", "as": "period_avg"},
              {"op": "max", "field": "density", "as": "peak"}
            ],
            "groupby": ["period"]
          }
        ],
        "mark": {"type": "rule", "color": "#FFFDF9", "strokeWidth": 2, "strokeDash": [3, 2]},
        "encoding": {
          "x": {
            "field": "period_avg",
            "type": "quantitative",
            "title": "Rating (out of 5)",
            "axis": {"values": [1.5, 2, 2.5, 3, 3.5, 4, 4.5], "grid": false},
            "scale": {"domain": [1.5, 4.5]}
          },
          "y": {"field": "peak", "type": "quantitative", "axis": null},
          "y2": {"datum": 0}
        }
      },
      {
        "description": "The average written at the right-hand end of each row",
        "transform": [
          {
            "aggregate": [{"op": "max", "field": "period_avg", "as": "period_avg"}],
            "groupby": ["period"]
          },
          {"calculate": "'average ' + format(datum.period_avg, '.2f')", "as": "avg_label"}
        ],
        "mark": {
          "type": "text",
          "align": "right",
          "baseline": "bottom",
          "dy": -3,
          "fontSize": 11.5,
          "fontWeight": 600,
          "color": "#2B1D14"
        },
        "encoding": {
          "x": {
            "datum": 4.5,
            "type": "quantitative",
            "title": "Rating (out of 5)",
            "axis": {"values": [1.5, 2, 2.5, 3, 3.5, 4, 4.5], "grid": false},
            "scale": {"domain": [1.5, 4.5]}
          },
          "y": {"datum": 0, "type": "quantitative", "axis": null},
          "text": {"field": "avg_label"}
        }
      }
    ]
  },
  "resolve": {"scale": {"y": "shared"}},
  "config": {"facet": {"spacing": 0}, "view": {"stroke": null}}
}
