{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Chart 3. Proportional symbol map: one circle per cocoa-growing country for the latest FAO year. Circle area = tonnes of cocoa beans grown. Circle colour = average rating of bars made from that country's beans (grey = fewer than 5 bars reviewed).",
  "width": "container",
  "height": 330,
  "autosize": {"type": "fit-x", "contains": "padding"},
  "projection": {"type": "equalEarth"},
  "layer": [
    {
      "data": {
        "url": "data/processed/world-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "transform": [{"filter": "datum.properties.iso3 != 'ATA'"}],
      "mark": {"type": "geoshape", "fill": "#EFE7DC", "stroke": "#FFFDF9", "strokeWidth": 0.5}
    },
    {
      "data": {"url": "data/processed/fao_cocoa_production.csv"},
      "transform": [
        {"joinaggregate": [{"op": "max", "field": "year", "as": "latest"}]},
        {"filter": "datum.year == datum.latest && datum.tonnes > 0 && isValid(datum.lon)"},
        {
          "lookup": "iso3",
          "from": {
            "data": {"url": "data/processed/bean_country_summary.csv"},
            "key": "iso3",
            "fields": ["n_bars", "avg_rating"]
          }
        },
        {"calculate": "isValid(datum.n_bars) ? datum.n_bars : 0", "as": "n_bars"},
        {
          "calculate": "datum.n_bars >= 5 ? format(datum.avg_rating, '.2f') : 'Too few bars reviewed'",
          "as": "rating_text"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.9,
        "stroke": "#FFFDF9",
        "strokeWidth": 1,
        "cursor": "pointer"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "size": {
          "field": "tonnes",
          "type": "quantitative",
          "title": "Cocoa grown (tonnes)",
          "scale": {"range": [15, 1800]},
          "legend": {
            "orient": "bottom-left",
            "format": "~s",
            "symbolFillColor": "#C9B8A6",
            "symbolStrokeWidth": 0,
            "values": [100000, 500000, 2000000]
          }
        },
        "color": {
          "condition": {"test": "datum.n_bars < 5", "value": "#C9BFB3"},
          "field": "avg_rating",
          "type": "quantitative",
          "title": "Average rating",
          "scale": {
            "domain": [2.8, 3.5],
            "range": ["#EFD5B2", "#C48A57", "#4E2A16"],
            "clamp": true
          },
          "legend": {
            "orient": "bottom-right",
            "direction": "horizontal",
            "gradientLength": 140,
            "format": ".1f",
            "values": [2.8, 3, 3.2, 3.4]
          }
        },
        "order": {"field": "tonnes", "sort": "descending"},
        "tooltip": [
          {"field": "country", "title": "Country"},
          {"field": "year", "title": "Year", "format": "d"},
          {"field": "tonnes", "title": "Cocoa grown (tonnes)", "format": ","},
          {"field": "n_bars", "title": "Bars reviewed"},
          {"field": "rating_text", "title": "Average rating"}
        ]
      }
    },
    {
      "description": "Annotation: name the biggest grower",
      "data": {"url": "data/processed/fao_cocoa_production.csv"},
      "transform": [
        {"joinaggregate": [{"op": "max", "field": "year", "as": "latest"}]},
        {"filter": "datum.year == datum.latest"},
        {
          "window": [{"op": "row_number", "as": "rank"}],
          "sort": [{"field": "tonnes", "order": "descending"}]
        },
        {"filter": "datum.rank == 1"},
        {
          "calculate": "'Biggest grower: ' + datum.country + ' (' + format(datum.tonnes / 1e6, '.1f') + ' million tonnes in ' + datum.year + ')'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -26,
        "dy": -18,
        "fontSize": 12.5,
        "fontWeight": 700,
        "color": "#2B1D14"
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}
